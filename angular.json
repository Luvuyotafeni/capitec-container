{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "capitec-app": {
      "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/capitec-app", "index": "src/index.html",
            "browser": "src/main.ts", "polyfills": ["zone.js"], "tsConfig": "tsconfig.json",
            "assets": [{ "glob": "**/*", "input": "src/assets", "output": "assets" }],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": { "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "700kB", "maximumError": "1.5MB" }] },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": { "production": { "buildTarget": "capitec-app:build:production" },
                              "development": { "buildTarget": "capitec-app:build:development" } },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
